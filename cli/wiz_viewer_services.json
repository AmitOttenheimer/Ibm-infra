{
  "name": "Wiz_Viewer_services",
  "description": "Grant view access to wiz for scanning services",
  "account_id": "",
  "policy": {
    "type": "access",
    "description": "Grant view access to wiz for scanning services",
    "resource": {
      "attributes": [
        {
          "key": "serviceType",
          "operator": "stringEquals",
          "value": "service"
        }
      ]
    },"control": {
      "grant": {
        "roles": [{
          "role_id": "crn:v1:bluemix:public:iam::::role:Viewer"
        }]
      }
    }
  }
}